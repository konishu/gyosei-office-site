---
const { title, description, href, icon } = Astro.props;
---
<a href={href} class="group block rounded-2xl border border-[var(--line)] bg-white p-5 no-underline transition hover:-translate-y-0.5 hover:border-[var(--brand)]">
  <div class="text-2xl" aria-hidden="true">{icon}</div>
  <h3 class="mt-3 text-lg font-bold">{title}</h3>
  <p class="mt-2 text-sm leading-7 text-[var(--muted)]">{description}</p>
  <p class="mt-4 text-sm font-semibold text-[var(--brand)]">詳しく見る →</p>
</a>
