<section id="contact" class="container-site mt-14 border-y border-[var(--line)] bg-white px-5 py-8 sm:px-7 sm:py-10">
  <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:gap-12">
    <div>
      <h2 class="mt-0 text-2xl font-bold leading-tight sm:text-3xl">まずはお気軽にご相談ください</h2>
      <p class="mt-4 max-w-xl text-sm leading-7 text-[var(--muted)]">相談内容が行政書士の業務範囲か分からなくても大丈夫です。内容を確認のうえ、対応可否をご案内します。</p>

      <div class="mt-6 border-y border-[var(--line)] bg-[var(--paper)] p-4 sm:p-5">
        <p class="text-xs text-[var(--muted)]">お電話</p>
        <p class="mt-1 text-2xl font-bold tracking-wide">000-0000-0000</p>
        <p class="mt-1 text-xs text-[var(--muted)]">受付 9:00〜18:00 / 平日（仮）</p>
      </div>
    </div>

    <form id="inline-contact-form" class="grid gap-4" novalidate>
      <label class="grid gap-2 text-sm font-medium">
        お名前
        <input
          name="name"
          type="text"
          required
          placeholder="山田 太郎"
          class="min-h-12 rounded-sm border border-[var(--line)] bg-[var(--paper)] px-4 text-base font-normal outline-none transition focus:border-[var(--brand)]"
        />
      </label>

      <label class="grid gap-2 text-sm font-medium">
        相談内容
        <select name="topic" class="min-h-12 rounded-sm border border-[var(--line)] bg-[var(--paper)] px-4 text-base font-normal outline-none transition focus:border-[var(--brand)]">
          <option>相続・遺言</option>
          <option>許認可・届出</option>
          <option>会社・法人設立</option>
          <option>その他</option>
        </select>
      </label>

      <label class="grid gap-2 text-sm font-medium">
        お問い合わせ内容
        <textarea
          name="message"
          required
          rows="5"
          placeholder="相談したい内容を簡単にご記入ください"
          class="rounded-sm border border-[var(--line)] bg-[var(--paper)] px-4 py-3 text-base font-normal outline-none transition focus:border-[var(--brand)]"
        ></textarea>
      </label>

      <button type="submit" class="min-h-12 rounded-sm bg-[var(--brand)] px-5 font-bold text-white transition hover:opacity-90">相談内容を確認する</button>
      <p id="inline-contact-result" aria-live="polite" class="text-sm text-[var(--muted)]">※ 送信機能は未実装</p>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector('#inline-contact-form');
  const result = document.querySelector('#inline-contact-result');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !(result instanceof HTMLElement)) return;

    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();

    result.textContent = name && message
      ? `${name}様：入力内容を確認できました。本番ではこの先で安全に送信します。`
      : 'お名前とお問い合わせ内容を入力してください。';
  });
</script>
