---
import '../styles/v2.css';

const {
  title = '小西行政書士事務所｜岡山市の相続・許認可・法人設立',
  description = '岡山市を中心に、相続・遺言、許認可、法人設立などの行政手続きを丁寧にサポートする行政書士事務所です。',
} = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const v2Base = `${base}v2/`;
const canonical = new URL(`${base}v2/`, Astro.site ?? Astro.url.origin);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: '小西行政書士事務所',
  description,
  areaServed: ['岡山市', '岡山県'],
  url: canonical.toString(),
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="icon" href={`${base}favicon.svg`} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{title}</title>
  </head>
  <body>
    <header class="v2-header">
      <div class="v2-container v2-header-inner">
        <a href={v2Base} class="v2-brand">
          <span class="v2-brand-caption">地域の身近な法律手続きパートナー</span>
          <span class="v2-brand-name">小西行政書士事務所</span>
        </a>
        <nav class="v2-nav" aria-label="メインメニュー">
          <a href={`${v2Base}#services`}>業務内容</a>
          <a href={`${v2Base}#about`}>事務所案内</a>
          <a href={`${v2Base}#contact`} class="v2-nav-cta">相談する</a>
        </nav>
        <a href={`${v2Base}#contact`} class="v2-mobile-cta">相談する</a>
      </div>
    </header>
    <main><slot /></main>
    <footer class="v2-footer">
      <div class="v2-container">小西行政書士事務所（仮） / 岡山県岡山市<br />※ 本サイトは開業準備中のデモです。個人情報・連絡先は掲載していません。</div>
    </footer>
  </body>
</html>
