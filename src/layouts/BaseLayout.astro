---
import '../styles/global.css';
const {
  title = '○○行政書士事務所',
  description = '○○市を中心に、相続・遺言、許認可、法人設立などの行政手続きを丁寧にサポートする行政書士事務所です。',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: '○○行政書士事務所',
  description,
  areaServed: ['○○市', '△△市'],
  url: canonical.toString(),
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="icon" href={`${base}favicon.svg`} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{title}</title>
  </head>
  <body>
    <header class="border-b border-[var(--line)] bg-[var(--paper)]/95">
      <div class="container-site flex min-h-20 items-center justify-between gap-4 py-3">
        <a href={base} class="no-underline">
          <p class="text-xs tracking-[0.18em] text-[var(--muted)]">地域の身近な法律手続きパートナー</p>
          <p class="mt-1 text-lg font-bold">○○行政書士事務所 <span class="text-xs font-normal text-[var(--muted)]">（仮）</span></p>
        </a>
        <nav class="hidden gap-6 text-sm md:flex">
          <a href={`${base}#services`}>業務内容</a>
          <a href={`${base}#about`}>事務所案内</a>
          <a href={`${base}contact/`} class="rounded-lg bg-[var(--brand)] px-4 py-2 font-semibold text-white no-underline">ご相談</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="mt-16 border-t border-[var(--line)] py-8 text-center text-xs leading-6 text-[var(--muted)]">
      <div class="container-site">○○行政書士事務所（仮） / ○○県○○市<br />※ 本サイトは開業準備中のデモです。個人情報・連絡先は掲載していません。</div>
    </footer>
  </body>
</html>
